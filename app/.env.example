# Paths
AUDIO_STEMS_STORAGE_ROOT=~/Audio Stems/Music
AUDIO_STEMS_TEMP_ROOT=~/Audio Stems/Music/_demucs_temp
AUDIO_STEMS_DATABASE_URL=sqlite:///audio_stems.db
AUDIO_STEMS_API_PORT=8000
# 127.0.0.1: this computer only. 0.0.0.0 lets phones and computers on your network open the app — it has no
# login, so anyone on that network can then use it; Windows asks once whether to allow Python through the firewall.
AUDIO_STEMS_API_HOST=127.0.0.1

# Application logs
AUDIO_STEMS_LOG_LEVEL=INFO
AUDIO_STEMS_LOG_FILE=~/Audio Stems/logs/app.jsonl
AUDIO_STEMS_LOG_MAX_BYTES=10485760
AUDIO_STEMS_LOG_BACKUP_COUNT=5

# Processing defaults preserve the standalone script's current behavior
AUDIO_STEMS_RETRY_COUNT=3
AUDIO_STEMS_RETRY_DELAYS=3,6
AUDIO_STEMS_ALLOWED_SOURCE_HOSTS=youtube.com,www.youtube.com,m.youtube.com,youtu.be
AUDIO_STEMS_BATCH_LIMIT=25
AUDIO_STEMS_UPLOAD_LIMIT_MB=500
AUDIO_STEMS_MODEL_NAME=hdemucs_mmi
AUDIO_STEMS_MODEL_DEVICE=auto
